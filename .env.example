# RAG 知识库问答系统环境变量模板
# 复制为 .env 后再填写本地、测试或生产环境的真实值。
# .env 支持以 # 开头的独立注释行；避免在密钥或 URL 后面写行尾注释。

# ------------------------------
# 应用基础配置
# ------------------------------

# 当前运行环境：development / test / production
APP_ENV=development

# 后端应用名称，用于日志、文档标题和健康检查响应。
APP_NAME="RAG 知识库问答系统 API"

# 是否开启调试模式。生产环境应设置为 false。
DEBUG=true

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# API 统一前缀，对应设计文档中的 /api/v1。
API_V1_PREFIX=/api/v1

# 应用时区。日志和统计报表建议统一使用 Asia/Shanghai。
APP_TIMEZONE=Asia/Shanghai


# ------------------------------
# 后端服务配置
# ------------------------------

# FastAPI 本地监听地址。
BACKEND_HOST=127.0.0.1

# FastAPI 本地监听端口。
BACKEND_PORT=8000

# 允许访问后端的前端来源，多个来源用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ------------------------------
# 前端配置
# ------------------------------

# Vite 前端访问后端 API 的基础地址。
VITE_API_BASE_URL=http://localhost:8000/api/v1

# 前端页面展示的系统名称。
VITE_APP_NAME="RAG 知识库问答系统"

# 前端默认是否启用 LLM 回答；false 时可只做检索调试。
VITE_DEFAULT_USE_LLM=true


# ------------------------------
# 数据库配置：Neon Postgres + pgvector
# ------------------------------

# SQLAlchemy 使用的数据库连接串。
# Neon 通常需要 sslmode=require；请替换 USER、PASSWORD、HOST、DATABASE。
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Alembic 或运维脚本可使用的直连地址。
# 如果暂时不区分连接池和直连，可与 DATABASE_URL 填相同数据库。
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 是否打印 SQL。开发调试可临时打开，生产环境应关闭。
DB_ECHO=false

# SQLAlchemy 连接池大小。
DB_POOL_SIZE=5

# 连接池耗尽时允许额外创建的连接数量。
DB_MAX_OVERFLOW=10


# ------------------------------
# 文档上传与解析
# ------------------------------

# 文件存储 provider：local / r2。
# development/test 默认 local；生产可切到 r2（Cloudflare R2，S3-compatible）。
STORAGE_PROVIDER=local

# local provider 的上传文件保存目录。建议不要提交该目录内容。
LOCAL_STORAGE_DIR=.data/uploads

# Cloudflare R2 配置。STORAGE_PROVIDER=r2 时必填 bucket、access key、secret，
# endpoint 可显式填写，也可通过 R2_ACCOUNT_ID 推导：
# https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=

# 单个上传文件大小上限，单位 MB。
MAX_UPLOAD_SIZE_MB=20

# 允许上传的文件扩展名，多个扩展名用英文逗号分隔。
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,md,txt


# ------------------------------
# Chunk 切分参数
# ------------------------------

# Parent chunk 用于给 LLM 提供完整上下文。
PARENT_CHUNK_SIZE=1800

# Parent chunk 的重叠字符数。
PARENT_CHUNK_OVERLAP=200

# Child chunk 用于 embedding 和检索。
CHILD_CHUNK_SIZE=500

# Child chunk 的重叠字符数。
CHILD_CHUNK_OVERLAP=100


# ------------------------------
# Embedding 配置：通义 / DashScope
# ------------------------------

# Embedding 服务提供商：fake / dashscope。
# 实际开发调试和生产环境使用 dashscope；自动化测试可显式覆盖为 fake。
EMBEDDING_PROVIDER=dashscope

# DashScope API Key。不要提交真实密钥。
DASHSCOPE_API_KEY=

# DashScope embedding HTTP API 地址。通常无需修改。
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding

# DashScope 文本向量模型名称。
EMBEDDING_MODEL=text-embedding-v4

# 向量维度，需要与 rag_chunks.embedding VECTOR(1536) 保持一致。
EMBEDDING_DIMENSION=1536

# 批量生成 embedding 时的批大小。
EMBEDDING_BATCH_SIZE=10


# ------------------------------
# LLM 配置：智谱大模型
# ------------------------------

# LLM 服务提供商。当前设计使用智谱。
LLM_PROVIDER=zhipu

# 智谱 API Key。不要提交真实密钥。
ZHIPUAI_API_KEY=

# 智谱模型名称。请按智谱控制台实际可用模型填写。
LLM_MODEL=glm-5.1

# 生成温度。RAG 问答建议保持较低，减少自由发挥。
LLM_TEMPERATURE=0.2

# 单次回答最大输出 token 数。
LLM_MAX_TOKENS=1200

# LLM 请求超时时间，单位秒。
LLM_TIMEOUT_SECONDS=120


# ------------------------------
# 默认检索配置
# ------------------------------

# 默认检索模式：VECTOR / KEYWORD / TRIGRAM / HYBRID
DEFAULT_SEARCH_MODE=HYBRID

# 向量检索候选数量。
VECTOR_TOP_K=20

# 全文关键词检索候选数量。
KEYWORD_TOP_K=20

# pg_trgm 模糊检索候选数量。
TRGM_TOP_K=20

# 最终传给 prompt 的 chunk 数量。
FINAL_TOP_K=5

# 混合检索中向量分数权重。
VECTOR_WEIGHT=0.65

# 混合检索中关键词分数权重。
KEYWORD_WEIGHT=0.25

# 混合检索中模糊匹配分数权重。
TRGM_WEIGHT=0.10

# 最低最终分数。低于该值可认为置信度不足。
MIN_FINAL_SCORE=0.55

# 低置信度阈值。低于该值时可选择不调用 LLM。
LOW_CONFIDENCE_SCORE=0.45


# ------------------------------
# 可选安全配置
# ------------------------------

# 用于未来 JWT、签名或会话加密。生产环境必须改成强随机字符串。
SECRET_KEY=change-me-in-production

# 访问令牌过期时间，单位分钟。当前 MVP 没有用户认证时可暂不使用。
ACCESS_TOKEN_EXPIRE_MINUTES=1440
